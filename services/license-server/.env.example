NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info
TRUST_PROXY=false
REQUIRE_HTTPS=false

# MySQL 8.0+; use a dedicated least-privilege database user in production.
DATABASE_URL=mysql://logicnest:replace_me@127.0.0.1:3306/logicnest_license

# Comma-separated browser origins. Desktop API requests may omit Origin.
ALLOWED_ORIGINS=http://localhost:5176

# Generate independent values with: openssl rand -base64 48
JWT_SECRET=replace_with_at_least_32_random_characters
REFRESH_TOKEN_HMAC_SECRET=replace_with_an_independent_32_byte_secret
ADMIN_SESSION_HMAC_SECRET=replace_with_an_independent_32_byte_secret
CARD_HMAC_SECRET=replace_with_an_independent_32_byte_secret
DEVICE_HMAC_SECRET=replace_with_an_independent_32_byte_secret
IP_HMAC_SECRET=replace_with_an_independent_32_byte_secret

# Ed25519 PKCS#8 private DER and SPKI public DER, each encoded as base64.
# See README.md for a safe generation command. Never commit the real values.
LICENSE_JWS_PRIVATE_KEY_B64=replace_with_base64_pkcs8_der
LICENSE_JWS_PUBLIC_KEY_B64=replace_with_base64_spki_der
LICENSE_JWS_KEY_ID=logicnest-license-2026-01

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12
OFFLINE_GRACE_HOURS=72
HEARTBEAT_INTERVAL_SECONDS=300
ONLINE_WINDOW_SECONDS=600

# Optional one-time bootstrap. Prefer `npm run admin:bootstrap`, then remove
# these values from the deployment environment after successful creation.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
